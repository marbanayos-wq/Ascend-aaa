{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A sportswear product available for purchase.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "type": "string" } },
        "isNew": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "stock": { "type": "integer" }
      },
      "required": ["name", "price", "category", "images", "sizes", "colors", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order containing products and shipping info.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "CartItem" } },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered"] },
        "trackingNumber": { "type": "string" },
        "shippingCarrier": { "type": "string" },
        "shippingInfo": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "address": { "type": "string" },
            "instructions": { "type": "string" }
          },
          "required": ["name", "email", "phone", "address"]
        },
        "paymentMethod": { "type": "string", "enum": ["card", "qr", "cod"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status", "shippingInfo", "paymentMethod", "createdAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "A product added to a cart with specific options.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "integer" },
        "selectedSize": { "type": "string" },
        "selectedColor": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "price", "quantity", "selectedSize", "selectedColor"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client"] }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of available products."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    }
  }
}
